# Keep the real key in .env.local or your hosting provider's secret manager.
GEMINI_API_KEY=

# Create a Supabase project, then copy its Project URL and publishable key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase web app configuration (Firebase Console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-only Firebase service-account values. Keep these out of NEXT_PUBLIC_* variables.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only Firebase UID for the Cirkitra owner account's unlimited monthly AI access.
# Find the UID in Firebase Console > Authentication > Users. Never use a NEXT_PUBLIC_ variable.
CIRKITRA_OWNER_UID=

# Server-only Supabase service role key, used for the one-time legacy account/project link.
SUPABASE_SERVICE_ROLE_KEY=

# PayPal subscriptions. Scope these same variable names by environment in Vercel:
# Sandbox values for Preview/Development; Live values only for Production.
# Keep checkout disabled until each app, plan, webhook, and API access is verified.
CIRKITRA_PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
# Create distinct $10 Maker and $20 Pro monthly plans in each PayPal environment.
# Blank or duplicate Pro plan IDs disable Pro; for Live, both tiers are required
# before any checkout can be enabled.
PAYPAL_PRO_PLAN_ID=
PAYPAL_WEBHOOK_ID=
CIRKITRA_PAYPAL_API_ACCESS_CONFIRMED=false
# Live also requires VERCEL_ENV=production, NODE_ENV=production, and a separate
# explicit confirmation. Keep this false until the production preflight passes.
CIRKITRA_PAYPAL_LIVE_BILLING_CONFIRMED=false
